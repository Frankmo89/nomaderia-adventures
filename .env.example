# Copy this file to .env and fill in your values
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SITE_URL=""
VITE_GA_MEASUREMENT_ID=""
VITE_SENTRY_DSN=""

# NOTE: the WhatsApp number is NOT an env var — it is hardcoded in src/lib/whatsapp.ts.

# ─────────────────────────────────────────────────────────────
# Supabase Edge Function secrets — set via Supabase CLI:
#   supabase secrets set RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
#
# These must NEVER be placed in this file or committed to git.
# ─────────────────────────────────────────────────────────────
# RESEND_API_KEY=          (Resend transactional email API key)
# SITE_URL=                (optional override for email link generation)

# ─────────────────────────────────────────────────────────────
# Cloudflare Pages Function (OG tags — ADR-032)
# Set in Pages → Settings → Environment variables (Production).
# The middleware also accepts the VITE_* names above as fallback.
# ─────────────────────────────────────────────────────────────
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-anon-or-publishable-key
